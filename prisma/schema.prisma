generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SocialPlatform {
  INSTAGRAM
  FACEBOOK
  TIKTOK
}

enum SocialConnectionStatus {
  CONNECTED
  EXPIRED
  DISCONNECTED
}

/// OAuth credentials for the publisher. Token columns are AES-GCM ciphertext, never plaintext.
model SocialAccount {
  id                String                 @id @default(cuid())
  platform          SocialPlatform
  accountName       String
  externalAccountId String
  accessTokenEnc    String?                @db.Text
  refreshTokenEnc   String?                @db.Text
  accessExpiresAt   DateTime?
  refreshExpiresAt  DateTime?
  scopes            String                 @default("")
  status            SocialConnectionStatus @default(DISCONNECTED)
  lastRefreshAt     DateTime?
  lastError         String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@unique([platform, externalAccountId])
  @@index([platform, status])
  @@map("social_accounts")
}

enum LivestockSpecies {
  SAPI
  KAMBING
  AYAM
  BEBEK
}

enum AnimalSex {
  JANTAN
  BETINA
  CAMPURAN
}

enum AnimalHealth {
  SEHAT
  PANTAU
  SAKIT
  KARANTINA
  TERJUAL
}

enum WasteBatchStatus {
  TERSEDIA
  MASUK_PRODUKSI
}

/// Live animals and the fresh manure they produce. Packaged stock stays on the sales ledger.
model Pen {
  id       String           @id
  name     String
  species  LivestockSpecies
  location String
  capacity Int
  animals  Animal[]
  waste    WasteBatch[]

  @@map("pens")
}

model Animal {
  id        String           @id
  earTag    String           @unique
  species   LivestockSpecies
  breed     String
  sex       AnimalSex
  birthDate DateTime         @db.Date
  weightKg  Decimal          @db.Decimal(8, 1)
  headcount Int
  health    AnimalHealth
  note      String           @default("")
  penId      String
  pen        Pen                 @relation(fields: [penId], references: [id])
  updatedAt  DateTime
  waste           WasteBatch[]
  healthLogs      LivestockHealthLog[]
  treatmentCases  LivestockTreatmentCase[]
  opsAlerts       LivestockOpsAlert[]
  medicalHistory  LivestockMedicalHistory[]
  scheduledTreatments LivestockTreatment[]
  lineage             LineageTracking?
  weightChecks        LivestockWeightCheck[]
  feedLogs            LivestockFeedLog[]
  withdrawalHolds     WithdrawalHold[]

  @@index([species, health])
  @@map("animals")
}

enum HealthCheckStatus {
  HEALTHY
  OBSERVATION
  QUARANTINE
  SICK
}

enum HealthRiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

/// One simulated check tied to an ear tag. The score is a planning aid, not a veterinary diagnosis.
model LivestockHealthLog {
  id             String            @id
  earTag         String            @map("ear_tag_id")
  animal         Animal            @relation(fields: [earTag], references: [earTag], onDelete: Cascade, onUpdate: Cascade)
  checkedAt      DateTime          @map("checked_at")
  status         HealthCheckStatus
  temperatureC   Decimal           @map("temperature_c") @db.Decimal(4, 1)
  activityLevel  Int               @map("activity_level")
  symptoms       String            @default("")
  riskLevel      HealthRiskLevel   @map("risk_level")
  score          Int
  diagnosticNote String            @map("diagnostic_note")
  treatment      String
  manual         Boolean           @default(false)
  createdAt      DateTime          @default(now()) @map("created_at")

  @@index([earTag, checkedAt])
  @@map("livestock_health_logs")
}

enum TreatmentCaseStatus {
  TERBUKA
  SELESAI
}

/// An open or closed treatment case for one ear tag. Doses are the medicines the keeper recorded.
model LivestockTreatmentCase {
  id          String               @id
  earTag      String               @map("ear_tag_id")
  animal      Animal               @relation(fields: [earTag], references: [earTag], onDelete: Cascade, onUpdate: Cascade)
  healthLogId String               @map("health_log_id")
  protocolId  String               @map("protocol_id")
  status      TreatmentCaseStatus  @default(TERBUKA)
  openedAt    DateTime             @map("opened_at")
  closedAt    DateTime?            @map("closed_at")
  doses       Json                 @default("[]")
  updatedAt   DateTime             @updatedAt @map("updated_at")

  @@index([earTag, status])
  @@map("livestock_treatment_cases")
}

/// Written by the animals health trigger when a normalized row becomes sick or quarantined.
model LivestockOpsAlert {
  id        String       @id @default(cuid())
  earTag    String       @map("ear_tag_id")
  animal    Animal       @relation(fields: [earTag], references: [earTag], onDelete: Cascade, onUpdate: Cascade)
  health    AnimalHealth
  createdAt DateTime     @default(now()) @map("created_at")

  @@index([earTag, createdAt])
  @@map("livestock_ops_alerts")
}

/// Expert-verified treatment actions. The assistant matches symptoms and vitals to these rows.
model TreatmentProtocol {
  id         String   @id
  name       String
  severity   String
  symptoms   String   @default("")
  routine    Boolean  @default(false)
  summary    String
  isolation  String
  medicines  Json
  steps      Json
  verified   Boolean  @default(true)
  updatedAt  DateTime @updatedAt

  @@map("treatment_protocols")
}

/// A protocol the keeper applied to one animal. This is the medical history entry.
model LivestockMedicalHistory {
  id           String   @id
  earTag       String   @map("ear_tag_id")
  animal       Animal   @relation(fields: [earTag], references: [earTag], onDelete: Cascade, onUpdate: Cascade)
  healthLogId  String   @default("") @map("health_log_id")
  protocolId   String   @map("protocol_id")
  protocolName String   @map("protocol_name")
  summary      String
  isolation    String
  appliedAt    DateTime @map("applied_at")

  @@index([earTag, appliedAt])
  @@map("livestock_medical_history")
}

enum LivestockCareKind {
  VACCINATION
  DEWORMING
  VITAMIN
  MEDICAL_CARE
}

enum LivestockCareStatus {
  PENDING
  COMPLETED
  OVERDUE
}

/// A planned vaccination, deworming, vitamin, or medical-care visit for one ear tag or poultry lot.
model LivestockTreatment {
  id          String              @id
  earTag      String              @map("ear_tag_id")
  animal      Animal              @relation(fields: [earTag], references: [earTag], onDelete: Cascade, onUpdate: Cascade)
  kind        LivestockCareKind
  scheduledOn DateTime            @map("scheduled_on") @db.Date
  staffName   String              @map("staff_name")
  dosage      String
  status      LivestockCareStatus @default(PENDING)
  completedAt DateTime?           @map("completed_at")
  note        String              @default("")
  createdAt   DateTime            @default(now()) @map("created_at")

  @@index([earTag, scheduledOn])
  @@index([status, scheduledOn])
  @@map("livestock_treatments")
}

model WasteBatch {
  id          String           @id
  animalId    String?
  animal      Animal?          @relation(fields: [animalId], references: [id])
  penId       String
  pen         Pen              @relation(fields: [penId], references: [id])
  species     LivestockSpecies
  massKg      Decimal          @db.Decimal(10, 1)
  collectedAt DateTime
  status      WasteBatchStatus @default(TERSEDIA)
  note        String           @default("")

  @@index([species, status])
  @@map("waste_batches")
}

enum ProductionStatus {
  DRAFT
  COMPLETED
}

/// A collection of fresh manure. remaining_kg is what production can still draw.
model WasteCollectionLog {
  id          String           @id
  category    LivestockSpecies
  weightKg    Decimal          @db.Decimal(10, 1)
  remainingKg Decimal          @db.Decimal(10, 1)
  collectedAt DateTime

  @@index([category, collectedAt])
  @@map("waste_collection_logs")
}

/// Finished SKU whose on-hand count production increments when a batch completes.
model ProductVariant {
  id          String            @id
  label       String
  family      String
  packageSize Decimal           @db.Decimal(8, 2)
  unit        String
  stockOnHand Int               @default(0)
  batches     ProductionBatch[]

  @@map("product_variants")
}

/// Staff sign-in secret. The hash never goes back to the browser.
model LoginCredential {
  id           String   @id
  email        String   @unique
  name         String
  role         String
  active       Boolean  @default(true)
  passwordHash String
  updatedAt    DateTime @updatedAt
  payrollRecords PayrollRecord[]

  @@map("login_credentials")
}

enum PayrollStatus {
  PENDING
  PAID
}

/// One employee, one calendar month. Net pay is base + commission + bonus − deductions.
model PayrollRecord {
  id            String        @id
  userId        String        @map("user_id")
  credential    LoginCredential @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  period        String
  role          String
  baseSalaryIdr Int           @map("base_salary_idr")
  commissionIdr Int           @map("commission_idr")
  bonusIdr      Int           @map("bonus_idr")
  deductionsIdr Int           @map("deductions_idr")
  netPayIdr     Int           @map("net_pay_idr")
  tonnageKg     Decimal       @map("tonnage_kg") @db.Decimal(12, 3)
  orderCount    Int           @map("order_count")
  healthHeads   Int           @map("health_heads")
  status        PayrollStatus @default(PENDING)
  paidAt        DateTime?     @map("paid_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  @@unique([userId, period])
  @@index([period, status])
  @@map("payroll_records")
}

/// Parents and life stage for one ear tag. Stage moves only forward: pedet, dewasa, culling.
model LineageTracking {
  id        String   @id
  earTag    String   @unique @map("ear_tag_id")
  animal    Animal   @relation(fields: [earTag], references: [earTag], onDelete: Cascade, onUpdate: Cascade)
  sireTag   String   @default("") @map("sire_tag")
  damTag    String   @default("") @map("dam_tag")
  stage     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("lineage_tracking")
}

model LivestockWeightCheck {
  id        String   @id
  earTag    String   @map("ear_tag_id")
  animal    Animal   @relation(fields: [earTag], references: [earTag], onDelete: Cascade, onUpdate: Cascade)
  weighedOn DateTime @map("weighed_on") @db.Date
  weightKg  Decimal  @map("weight_kg") @db.Decimal(8, 1)

  @@index([earTag, weighedOn])
  @@map("livestock_weight_checks")
}

model LivestockFeedLog {
  id     String   @id
  earTag String   @map("ear_tag_id")
  animal Animal   @relation(fields: [earTag], references: [earTag], onDelete: Cascade, onUpdate: Cascade)
  fedOn  DateTime @map("fed_on") @db.Date
  feedKg Decimal  @map("feed_kg") @db.Decimal(8, 1)

  @@index([earTag, fedOn])
  @@map("livestock_feed_logs")
}

/// One compost planning run. Finished kilograms already subtract the stated mass loss.
model CompostRun {
  id               String   @id
  rawKg            Decimal  @map("raw_kg") @db.Decimal(10, 1)
  carbonPercent    Decimal  @map("carbon_percent") @db.Decimal(5, 2)
  nitrogenPercent  Decimal  @map("nitrogen_percent") @db.Decimal(5, 2)
  cnRatio          Decimal  @map("cn_ratio") @db.Decimal(6, 1)
  lossPercent      Decimal  @map("loss_percent") @db.Decimal(5, 2)
  finishedKg       Decimal  @map("finished_kg") @db.Decimal(10, 1)
  peakCelsius      Decimal? @map("peak_celsius") @db.Decimal(4, 1)
  thermophilicDays Int      @map("thermophilic_days")
  createdAt        DateTime @default(now()) @map("created_at")

  @@map("compost_runs")
}

/// Open consignment suggestion for one partner and month. Invoice prices are not rewritten.
model ConsignmentLedger {
  id                 String   @id
  partnerId          String   @map("partner_id")
  period             String
  openIdr            Int      @map("open_idr")
  volumeKg           Decimal  @map("volume_kg") @db.Decimal(12, 3)
  discountRate       Decimal  @map("discount_rate") @db.Decimal(5, 4)
  suggestedCreditIdr Int      @map("suggested_credit_idr")
  createdAt          DateTime @default(now()) @map("created_at")

  @@unique([partnerId, period])
  @@map("consignment_ledgers")
}

model FieldVisit {
  id        String   @id
  partnerId String   @map("partner_id")
  agentId   String   @default("") @map("agent_id")
  visitedAt DateTime @map("visited_at")
  lat       Decimal? @db.Decimal(9, 6)
  lng       Decimal? @db.Decimal(9, 6)
  note      String   @default("")

  @@index([partnerId, visitedAt])
  @@map("field_visits")
}

/// Symptom to keeper-protocol checklist. Not a diagnosis and not a mg/kg dose.
model VeterinaryRule {
  id         String @id
  symptom    String
  protocolId String @map("protocol_id")
  summary    String

  @@index([symptom])
  @@map("veterinary_rules")
}

model WithdrawalHold {
  id           String    @id
  earTag       String    @map("ear_tag_id")
  animal       Animal    @relation(fields: [earTag], references: [earTag], onDelete: Cascade, onUpdate: Cascade)
  medicineName String    @map("medicine_name")
  startedAt    DateTime  @map("started_at")
  untilOn      DateTime  @map("until_on") @db.Date
  releasedAt   DateTime? @map("released_at")

  @@index([earTag, untilOn])
  @@map("withdrawal_holds")
}

/// Company books shared by every browser: sales, livestock, publisher, and staff.
/// revision increments on each save so two devices cannot silently overwrite each other.
model Ledger {
  key       String   @id
  revision  Int
  payload   Json
  updatedAt DateTime @updatedAt

  @@map("ledgers")
}

/// Composting batch. output_units = floor((raw_weight_kg * conversion_rate) / package_size).
model ProductionBatch {
  id             String           @id
  category       LivestockSpecies
  rawWeightKg    Decimal          @db.Decimal(10, 1)
  conversionRate Decimal          @db.Decimal(6, 4)
  variantId      String
  variant        ProductVariant   @relation(fields: [variantId], references: [id])
  packageSize    Decimal          @db.Decimal(8, 2)
  outputUnits    Int
  status         ProductionStatus @default(DRAFT)
  completedAt    DateTime?
  createdAt      DateTime         @default(now())

  @@index([category, status])
  @@map("production_batches")
}
