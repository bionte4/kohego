# PostgreSQL connection string used only by the server.
DATABASE_URL="postgresql://kohego:kohego@localhost:5432/kohego?schema=public"

# 32-byte key, base64. Generate with: openssl rand -base64 32
# Changing this key makes stored tokens unreadable.
TOKEN_ENCRYPTION_KEY=""

# Signs the local role cookie. Falls back to TOKEN_ENCRYPTION_KEY, then a dev-only secret.
# ROLE_SESSION_SECRET=""

# Google sign-in (NextAuth). Generate NEXTAUTH_SECRET with: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Set to 1 to allow the role switcher when NODE_ENV=production.
# KOHEGO_ALLOW_ROLE_SWITCH=""

# Meta app used for Facebook and Instagram (Graph API).
META_APP_ID=""
META_APP_SECRET=""

# TikTok Login Kit / Content Posting.
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
